---
const {title = 'NeuroLaunch Daily', description = 'Practical reading for a thoughtful day.'} = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<!doctype html>
<html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width"/><meta name="description" content={description}/><title>{title}</title>
<style is:global>
:root{font-family:system-ui,sans-serif;color:#182c2a;background:#f5f5ef;line-height:1.7}*{box-sizing:border-box}body{margin:0}a{color:inherit}header,main,footer{max-width:1100px;margin:auto;padding:24px}header{display:flex;justify-content:space-between;gap:16px;border-bottom:1px solid #d7ded5}.brand{font-weight:800;text-decoration:none}nav a{margin-left:16px}h1,h2,h3{line-height:1.2}h1{font-size:clamp(2.2rem,6vw,4rem);letter-spacing:-.04em}p{max-width:72ch}.muted,small{color:#54675f}.eyebrow{text-transform:uppercase;letter-spacing:.14em;font-size:.75rem;color:#386453}.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:20px}.card{background:white;padding:26px;border:1px solid #dde3d9;border-radius:16px}.card h2{font-size:1.4rem}.card a{text-decoration:none}.controls{display:flex;flex-wrap:wrap;gap:12px;margin:28px 0}input,select{padding:12px;border:1px solid #bac9c0;border-radius:8px;font:inherit;background:white}input{flex:1;min-width:180px}.article{max-width:780px}.article h1{font-size:clamp(2rem,5vw,3.3rem)}.notice{padding:16px;background:#e8eee3;border-radius:10px;font-size:.9rem}footer{margin-top:50px;border-top:1px solid #d7ded5;font-size:.85rem}a:focus-visible,input:focus-visible,select:focus-visible{outline:3px solid #36836b;outline-offset:4px}[hidden]{display:none!important}
</style></head><body><header><a class="brand" href={`${base}/`}>NeuroLaunch Daily</a><nav aria-label="Main"><a href={`${base}/`}>Latest</a><a href={`${base}/archive/`}>Archive</a></nav></header><main><slot/></main><footer>Independent project. Not affiliated with NeuroLaunch. AI-generated educational summaries may contain errors and are not medical advice. Consult the original source and qualified professionals for health decisions.</footer></body></html>
